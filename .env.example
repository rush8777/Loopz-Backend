# DATABASE_URL=file:./dev.db
DATABASE_URL=libsql://your-database.turso.io

# Required for remote libsql:// Turso URLs; leave empty for local file databases.
DATABASE_AUTH_TOKEN=replace-with-your-turso-auth-token
# Generate a unique value of at least 32 characters; never use this placeholder in production.
JWT_SECRET=replace-with-a-long-random-secret
PORT=3000
NODE_ENV=development
DASHBOARD_URL=http://localhost:5173
# OAuth 2.0 Web application client ID. No client secret is used for ID-token authentication.
GOOGLE_CLIENT_ID=

# Paddle Billing. The three price IDs must be recurring monthly prices. Keep the
# API key server-only; it must never be exposed through a browser environment variable.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_STARTER_PRICE_ID=
PADDLE_GROWTH_PRICE_ID=
PADDLE_SCALE_PRICE_ID=
